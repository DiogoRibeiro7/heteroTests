% Generated by hand for benchmarking utilities
\name{run_benchmark_suite}
\alias{run_benchmark_suite}
\alias{generate_benchmark_report}
\title{Benchmark \pkg{heteroTests} against reference implementations}
\description{\code{run_benchmark_suite()} evaluates a selection of
heteroscedasticity diagnostics across varying sample sizes while measuring
runtime, memory allocation, and statistical agreement with the
\pkg{lmtest} and \pkg{car} packages. The companion
\code{generate_benchmark_report()} helper aggregates the raw output into tidy
summary tables and recommendations.}
\usage{
run_benchmark_suite(
  sample_sizes = c(100L, 500L, 1000L, 10000L, 100000L, 1000000L),
  tests = NULL,
  replicates = 3L,
  hetero_patterns = c("none", "linear", "group"),
  hetero_strength = 1,
  baseline_packages = c("lmtest", "car"),
  seed = 123L,
  n_predictors = 4L,
  profile_memory = TRUE,
  progress = interactive()
)

generate_benchmark_report(benchmark_results, accuracy_tolerance = 1e-4)
}
\arguments{
  \item{sample_sizes}{Integer vector of observation counts to benchmark. Values
  may range from a few hundred observations to one million.}

  \item{tests}{Optional character vector restricting the benchmark to specific
  diagnostics (currently \code{"breusch_pagan"}, \code{"koenker"}, and
  \code{"ncv"}).}

  \item{replicates}{Scalar integer applied to all sample sizes or an integer
  vector matching \code{sample_sizes} to control the number of repetitions per
  configuration.}

  \item{hetero_patterns}{Character vector describing the heteroscedasticity
  patterns used when generating synthetic data. Supported values are
  \code{"none"}, \code{"linear"}, \code{"group"}, and \code{"exponential"}; the
  vector is recycled across replications.}

  \item{hetero_strength}{Positive numeric multiplier controlling the severity of
  variance heterogeneity.}

  \item{baseline_packages}{Character vector of external packages used for
  comparisons. Missing dependencies are skipped and reported in the metadata.}

  \item{seed}{Integer seed passed to the data generator for reproducibility.}

  \item{n_predictors}{Number of regressors (excluding the intercept) used when
  simulating benchmark datasets.}

  \item{profile_memory}{Logical; when \code{TRUE} and the \pkg{bench} package is
  installed, the suite records peak memory allocations in megabytes.}

  \item{progress}{Logical indicating whether to display a textual progress bar
  during execution.}

  \item{benchmark_results}{List returned by \code{run_benchmark_suite()}.}

  \item{accuracy_tolerance}{Non-negative numeric tolerance for declaring
  statistical agreement with reference implementations (based on absolute
  p-value differences).}
}
\value{\code{run_benchmark_suite()} returns a list with four elements:
\describe{
  \item{performance}{Data frame containing runtime, memory, and inference
  metrics for every test, sample size, and replicate.}
  \item{accuracy}{Data frame recording absolute differences in p-values and test
  statistics relative to each baseline implementation.}
  \item{summary}{List of aggregated medians for quick inspection of speed,
  memory, and accuracy.}
  \item{metadata}{Metadata describing the benchmark configuration (sample sizes,
  baselines, seed, and availability of optional dependencies).}
}
\code{generate_benchmark_report()} converts the raw results into aggregated
speed, memory, accuracy, recommendation, and scalability tables alongside the
original metadata.}
\details{Datasets are generated from a linear regression model with a configurable
number of predictors and variance patterns (none, linear, group, or exponential).
Each diagnostic from \pkg{heteroTests} is executed alongside equivalent tests
from \pkg{lmtest} and \pkg{car} when available. Memory profiling is enabled via
\pkg{bench} when installed; otherwise only runtimes are collected. The output is
suitable for regression testing (to detect performance regressions) and for
building artefacts such as CSV benchmark reports.}
\examples{
\donttest{
if (requireNamespace("lmtest", quietly = TRUE) &&
    requireNamespace("car", quietly = TRUE)) {
  results <- run_benchmark_suite(
    sample_sizes = c(100L, 250L),
    replicates = 1L,
    profile_memory = FALSE,
    progress = FALSE
  )
  report <- generate_benchmark_report(results)
  head(report$recommendations)
}
}
}
